# Copy to .env and set your Anthropic API key for local proxy auth.
# Do not commit real secrets.
ANTHROPIC_API_KEY=sk-ant-...
PORT=4173

# Telemetry admin gate for /connect?telemetry=1 summary panel.
# Must match the server env var used by /api/help/kb-telemetry-summary.
KB_TELEMETRY_ADMIN_TOKEN=replace_with_a_long_random_token

# Optional: override from client (not recommended for production).
# VITE_ANTHROPIC_API_URL=/api/anthropic/messages

# Google Search Console Indexing API (base64-encoded service account JSON)
# See docs/GSC_SETUP.md for setup instructions
# GSC_SERVICE_ACCOUNT_KEY=base64_encoded_json_key_here
